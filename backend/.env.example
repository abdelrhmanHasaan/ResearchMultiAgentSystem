# =============================================================================
# Autonomous Research Platform - backend configuration
# Copy this file to `.env` and fill in what you have. The app works with
# ANY ONE provider; leave the rest empty.
# =============================================================================

# --- Provider selection ------------------------------------------------------
# auto (default) = first available in order: openrouter -> groq -> openai -> gemini -> ollama
# Or force one: openrouter | groq | openai | gemini | ollama
LLM_PROVIDER=auto

# --- Per-stage routing (optional) ---------------------------------------------
# Route each agent to a different provider - e.g. draft with a hosted frontier
# model while running the critic for free on local Ollama. Empty = global.
PLANNER_PROVIDER=
WRITER_PROVIDER=
CRITIC_PROVIDER=

# --- Cost calculation ----------------------------------------------------------
# Optional JSON overrides/extensions for the model price catalog
# (USD per 1M tokens). Known models are priced automatically; unknown models
# are tracked by tokens with cost=null.
# PRICE_OVERRIDES_JSON={"my-deployed-model": {"input": 0.5, "output": 1.5}}

# --- Hosted providers (API keys) ---------------------------------------------
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Local models (Ollama) ----------------------------------------------------
# Install from https://ollama.com then:
#   ollama pull llama3.1:8b-instruct-q4_K_M
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Pipeline tuning ----------------------------------------------------------
LLM_TIMEOUT_SECONDS=180
MAX_REVISION_LOOPS=3
CRITIC_PASS_SCORE=7.0

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8679
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
